# Copy to .env and fill in. .env is git-ignored; never commit real keys.

PORT=4000
NODE_ENV=development
# Comma-separated list of browser origins allowed by CORS (mobile apps don't need this).
CORS_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/ridecompare

# ---- Maps: search, reverse geocoding, routes ----
# osm    = FREE OpenStreetMap services (Photon + OSRM). No key. Fair-use public servers: dev only.
# google = Google Maps Platform (Places API (New), Geocoding, Routes). Needs key + billing.
# demo   = offline landmark list + straight-line routes.
# Switching is just this setting; see docs/MAPS.md.
MAPS_PROVIDER=osm

# Free search for MAPS_PROVIDER=osm. Sign up at https://myprojects.geoapify.com (email only, no card;
# 3,000 requests/day). Without it, search uses the free Photon server, then the offline landmark list.
GEOAPIFY_API_KEY=

# Only used when MAPS_PROVIDER=google. Restrict it by API in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Optional: point these at self-hosted servers for production use of OSM.
# OSM_PHOTON_URL=https://photon.komoot.io
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSM_OSRM_URL=https://router.project-osrm.org
# OSM_USER_AGENT=RideCompare/1.0 (development)

# ---- Provider integrations (LIVE ONLY) ----
# There are NO demo prices. A provider without credentials shows "Live pricing unavailable".
# Credentials stay on this backend only. See docs/PROVIDER_APIS.md.

# Uber, option A (preferred): Uber for Business "Guest Rides" API. Needs an approved U4B organisation.
# Uber issues a client id/secret with the guests.trips scope; the org UUID is in the U4B dashboard.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ORG_UUID=
# Uber, option B: Riders API server token (GET /v1.2/estimates/price). Approval-only. Uber's API Terms
# (section II B) forbid competitor price comparison without Uber's written permission.
UBER_SERVER_TOKEN=
UBER_API_BASE_URL=https://api.uber.com
# Use https://sandbox-api.uber.com while testing with sandbox credentials.

# Ola partner API (invite-only; apply via affiliates@olacabs.com). X-APP-TOKEN from Ola.
OLA_APP_TOKEN=
# Optional user OAuth token: needed for Ola upfront fares (whitelisted partners only).
OLA_USER_TOKEN=
OLA_API_BASE_URL=https://devapi.olacabs.com

# Rapido: no official API exists. Always "Live pricing unavailable" until Rapido grants partner access.

# Timeout for each provider/maps call, in milliseconds.
UPSTREAM_TIMEOUT_MS=6000
