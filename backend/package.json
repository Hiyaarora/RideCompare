{
  "name": "ridecompare-backend",
  "version": "1.0.0",
  "description": "RideCompare API: compares ride fare estimates across Uber, Ola and Rapido.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "TZ=Asia/Kolkata node --test --test-reporter=spec test/"
  },
  "dependencies": {
    "axios": "1.21.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "mongoose": "9.11.4",
    "morgan": "1.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "supertest": "7.3.1"
  }
}
